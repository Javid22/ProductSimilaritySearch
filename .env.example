# Copy to .env and adjust for your environment. Never commit the real .env file.

# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8005

# Comma-separated list of origins allowed to call the API (the frontend dev
# server runs on 5173 by default; add your deployed frontend origin in prod).
CORS_ALLOW_ORIGINS=http://localhost:5173

# Uncomment to override where data/model artifacts are read from.
# DATA_RAW_DIR=./data/raw
# DATA_PROCESSED_DIR=./data/processed
# MODELS_DIR=./models
